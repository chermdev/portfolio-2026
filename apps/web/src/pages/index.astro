---
import Layout from '@portfolio/site/layouts/Layout.astro';
import ToolList from '../components/ToolList.astro';
import ProjectList from '../components/ProjectList.astro';
import { buttonVariants } from '@portfolio/ui/components/button';
import { ArrowUpRight, ArrowRight, AppWindow, Bot, Sparkles } from 'lucide-react';
import { site } from '@portfolio/site/lib/site';
import { localeFromPath, localizePath } from '@portfolio/i18n';
const locale = localeFromPath(Astro.url.pathname);
const index = [
  { path: '/#about', title: 'About', description: 'Who I am and how I like to work.' },
  { path: '/projects', title: 'Projects', description: 'Websites, apps, bots, and automation.' },
  { path: '/tools', title: 'Free tools', description: 'Calculators that run in your browser. Image and video compressors are next.' },
];
const focus = [
  { icon: AppWindow, title: 'Websites and apps', description: 'Sites for businesses and apps that solve one problem clearly, from the first idea to launch.' },
  { icon: Bot, title: 'Automation and testing', description: 'Test suites, crawlers, and workflows that check, collect, or click so nobody has to. Playwright, TypeScript, Python, and n8n.' },
  { icon: Sparkles, title: 'AI in development', description: 'I set up AI agents with skills, instructions, and MCP servers so they take on repetitive work, from writing tests to analyzing failures.' },
];
---
<Layout schema={{ '@context': 'https://schema.org', '@type': 'Person', name: 'Charlie', alternateName: 'chermdev', url: site.url, sameAs: [site.github, site.linkedin] }}>
  <section class="page-shell">
    <div class="hero-grid gap-12">
      <div class="hero-copy">
        <p class="meta mb-7 flex items-center gap-3"><span class="size-2 rounded-full bg-success"></span>Charlie · chermdev</p>
        <h1 class="display">I build websites, apps, and automations.</h1>
        <p class="lead mt-7 max-w-lg">People know me as Charlie. I work in test automation and full-stack development. I also like setting up AI agents, with skills and instructions, so they can develop more autonomously.</p>
        <div class="mt-9 flex flex-wrap items-center gap-4"><a class={buttonVariants({size: "lg"})} href="/tools">Try the tools <ArrowRight data-icon="inline-end" /></a><a class={buttonVariants({size: "lg", variant: "ghost"})} href="/projects">See projects <ArrowUpRight data-icon="inline-end" /></a></div>
      </div>
      <nav aria-label="On this site" class="rounded-2xl border bg-card p-2">
        <p class="meta px-5 pt-4 pb-2">On this site</p>
        {index.map(item => <a href={item.path} class="group grid gap-1 rounded-xl px-5 py-4 transition-colors duration-150 hover:bg-secondary"><span class="meta">{localizePath(item.path, locale)}</span><span class="flex items-center justify-between gap-4 font-medium">{item.title}<ArrowUpRight aria-hidden="true" size={16} strokeWidth={1.5} /></span><span class="text-sm leading-6 text-muted-foreground">{item.description}</span></a>)}
        <div class="grid gap-1 px-5 py-4 text-muted-foreground"><span class="meta">later</span><span class="font-medium">Blog and courses</span><span class="text-sm leading-6">Notes and video lessons, once there’s enough worth sharing.</span></div>
      </nav>
    </div>
  </section>
  <section id="about" class="bg-secondary/50"><div class="page-shell section grid gap-12 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div class="md:sticky md:top-8 md:self-start">
      <p class="meta mb-4">About</p><h2 class="section-heading">Hi, I’m Charlie.</h2>
      <ul class="mt-10 grid gap-7">{focus.map(({ icon: Icon, ...item }) => <li class="flex gap-4"><Icon className="mt-0.5 shrink-0" size={22} strokeWidth={1.5} /><div><h3 class="font-medium tracking-tight">{item.title}</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">{item.description}</p></div></li>)}</ul>
    </div>
    <div class="flex flex-col items-start gap-6 pt-2">
      <p class="lead">I’m a creative, curious person. I like understanding how things work, building websites and apps, automating processes, and working with AI. I want what I make to be useful, offer a good experience, and be built with quality.</p>
      <p class="lead">I work in test automation with Playwright and TypeScript, using AI throughout the process: planning, development, maintenance (debugging, fixing, and updating), and reviewing results. To me, AI is a tool that works alongside you: it helps me research, plan, build, stay organized, and sort out my ideas.</p>
      <p class="lead">I think AI amplifies what you already know rather than replacing it. Someone who knows a subject gets better results with it than someone who doesn’t, which is why I keep learning new things.</p>
      <blockquote class="border-l-2 border-primary pl-5 text-lg font-medium leading-8">It’s not only about building, but about doing it right from the start, so it can be maintained and extended without breaking what already works.</blockquote>
      <p class="lead">My projects start from a real problem, mine or someone else’s: a business that needs its website, a team that needs software for its day-to-day, a process that should run on its own. I like taking an idea all the way to something people actually use.</p>
      <p class="lead">Lately I’ve been interested in building my own harness so AI agents can develop apps more autonomously, without sacrificing quality or security, and with the important decisions still in my hands.</p>
      <p class="lead">Outside of code, I like cars, pickup trucks and off-roading, drones and robots, board games, PC gaming (lately Rocket League, Wardogs, and Battlefield 6), and the Apple ecosystem, where everything just works together.</p>
      <div class="flex flex-wrap gap-6"><a href={site.github} class="text-link">GitHub <ArrowUpRight size={16} /></a><a href={site.linkedin} class="text-link">LinkedIn <ArrowUpRight size={16} /></a></div>
    </div>
  </div></section>
  <section id="projects" class="page-shell section">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6"><div><p class="meta mb-4">Selected projects</p><h2 class="section-heading">Things I’ve built.</h2></div><a class="text-link" href="/projects">All projects <ArrowUpRight size={16} /></a></div>
    <ProjectList featured />
  </section>
  <section class="page-shell pb-section">
    <div class="grid gap-10 border-t pt-section lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div><p class="meta mb-4">Tools</p><h2 class="subheading">Free tools.</h2><p class="mt-5 text-muted-foreground leading-7">No sign-up, and your inputs stay on your device. Finance calculators today. Media tools are next.</p><a class="text-link mt-4" href="/tools">All tools <ArrowUpRight size={16} /></a></div>
      <ToolList />
    </div>
  </section>
  <section class="page-shell flex flex-wrap items-center justify-between gap-8 border-t py-section"><div><p class="meta mb-3">Contact</p><h2 class="subheading">Have something to build?</h2></div><a class={buttonVariants({size: "lg"})} href={site.linkedin}>Message me on LinkedIn <ArrowUpRight data-icon="inline-end" /></a></section>
</Layout>
