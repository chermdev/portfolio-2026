---
import { localeFromPath } from '@portfolio/i18n';
import Layout from '@portfolio/site/layouts/Layout.astro';
import ComponentGallery from '@portfolio/ui/system-design/ComponentGallery';
import { PiggyBank } from 'lucide-react';
---
<Layout title="Design system" noindex><section class="page-shell section"><p class="mb-5 text-sm text-muted-foreground">The shared foundation</p><h1 class="section-heading">One language.<br />Room to explore.</h1><p class="lead mt-6 mb-12">The living reference for every page, tool, and future experiment. Changes start here.</p><div class="grid grid-cols-2 gap-4 sm:grid-cols-5"><div class="rounded-xl border bg-background p-6">Background</div><div class="rounded-xl bg-primary text-primary-foreground p-6">Primary</div><div class="rounded-xl bg-secondary text-secondary-foreground p-6">Secondary</div><div class="rounded-xl bg-accent text-accent-foreground p-6">Accent</div><div class="rounded-xl bg-muted text-muted-foreground p-6">Muted</div></div><div class="my-12 grid gap-8 border-y py-8 md:grid-cols-3"><div><p class="text-sm text-muted-foreground mb-4">Typography</p><p class="subheading">Manrope</p><p class="mt-3 text-sm text-muted-foreground">One family, a fluid scale.</p><p class="meta mt-3">.meta · /tools · Python · FastAPI</p></div><div><p class="text-sm text-muted-foreground mb-4">Surfaces</p><div class="flex gap-3"><div class="size-12 rounded-sm bg-secondary"></div><div class="size-12 rounded-lg bg-secondary"></div><div class="size-12 rounded-2xl bg-secondary"></div></div><div class="hero-gradient mt-4 h-24 rounded-lg border"><p class="meta p-3">.hero-gradient</p></div><div class="tool-widget mt-4" style="--app: var(--glow-1)"><div class="flex items-center gap-3"><span class="app-icon"><PiggyBank size={22} strokeWidth={1.75} /></span><p class="meta">.tool-widget · .app-icon</p></div><p class="tool-widget-value mt-4">$1,234.56</p></div><div class="result-panel mt-4 gap-3"><p class="meta">.receipt · .amount-field · .faq</p><dl class="receipt"><div class="receipt-row"><dt>Customer pays</dt><dd>$1,000.00</dd></div><div class="receipt-row"><dt><span aria-hidden="true">− </span>Processing fees</dt><dd>$39.00</dd></div><div class="receipt-row receipt-total"><dt><span aria-hidden="true">= </span>You keep</dt><dd>$954.76</dd></div></dl></div></div><div><p class="text-sm text-muted-foreground mb-4">Principles</p><p class="text-sm leading-7">Semantic tokens. Shared components.<br />Quiet motion. Visible focus.</p></div></div><ComponentGallery locale={localeFromPath(Astro.url.pathname)} client:load /></section></Layout>
