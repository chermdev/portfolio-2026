---
import { localeFromPath } from '@portfolio/i18n';
import Layout from '@portfolio/site/layouts/Layout.astro';
import ComponentGallery from '@portfolio/ui/system-design/ComponentGallery';
import { ChevronRight, PiggyBank } from 'lucide-react';
import { ShareBars, BlockShape, TornPaper, CashRegister } from '@portfolio/ui/components/share-chart';
import { Iceberg } from '@portfolio/ui/components/iceberg';
---
<Layout title="Design system" noindex><section class="page-shell section"><p class="mb-5 text-sm text-muted-foreground">The shared foundation</p><h1 class="section-heading">One language.<br />Room to explore.</h1><p class="lead mt-6 mb-12">The living reference for every page, tool, and future experiment. Changes start here.</p><div class="grid grid-cols-2 gap-4 sm:grid-cols-5"><div class="rounded-xl border bg-background p-6">Background</div><div class="rounded-xl bg-primary text-primary-foreground p-6">Primary</div><div class="rounded-xl bg-secondary text-secondary-foreground p-6">Secondary</div><div class="rounded-xl bg-accent text-accent-foreground p-6">Accent</div><div class="rounded-xl bg-muted text-muted-foreground p-6">Muted</div></div><div class="my-12 grid gap-8 border-y py-8 md:grid-cols-3"><div><p class="text-sm text-muted-foreground mb-4">Typography</p><p class="subheading">Manrope</p><p class="mt-3 text-sm text-muted-foreground">One family, a fluid scale.</p><p class="meta mt-3">.meta · /tools · Python · FastAPI</p></div><div><p class="text-sm text-muted-foreground mb-4">Surfaces</p><div class="flex gap-3"><div class="size-12 rounded-sm bg-secondary"></div><div class="size-12 rounded-lg bg-secondary"></div><div class="size-12 rounded-2xl bg-secondary"></div></div><div class="hero-gradient mt-4 h-24 rounded-lg border"><p class="meta p-3">.hero-gradient</p></div><div class="tool-widget mt-4" style="--app: var(--glow-1)"><div class="flex items-center gap-3"><span class="app-icon"><PiggyBank size={22} strokeWidth={1.75} /></span><p class="meta">.tool-widget · .app-icon</p></div><CashRegister className="mt-4" parts={[{ label: 'What you receive', value: 95, color: 'var(--glow-2)' }, { label: 'Stripe fees', value: 5, color: 'var(--glow-1)' }]} /></div><div class="tool-widget mt-4"><p class="meta">CashRegister · TornPaper · BlockShape · ShareBars · .share-chart</p><BlockShape className="mt-4" shape="car" parts={[{ label: 'What you borrow', value: 85, color: 'var(--glow-2)' }, { label: 'Interest', value: 15, color: 'var(--glow-1)' }]} /><BlockShape className="mt-4" shape="house" parts={[{ label: 'What you borrow', value: 45, color: 'var(--glow-2)' }, { label: 'Interest', value: 55, color: 'var(--glow-1)' }]} /><TornPaper className="mt-4" shape="bill" parts={[{ label: 'Your take-home pay', value: 88, color: 'var(--glow-2)' }, { label: 'ISR withheld', value: 12, color: 'var(--glow-1)' }]} /><TornPaper className="mt-4" shape="receipt" parts={[{ label: 'What you keep', value: 99, color: 'var(--glow-2)' }, { label: 'ISR for the month', value: 1, color: 'var(--glow-1)' }]} /><ShareBars className="mt-4" parts={[{ label: 'What you save', color: 'var(--glow-2)' }, { label: 'What it earns', color: 'var(--glow-1)' }]} steps={[[2, 0.2], [4, 0.8], [6, 1.8], [8, 3.2], [10, 5]]} /></div><div class="result-panel mt-4 gap-3"><p class="meta">Iceberg · .iceberg</p><Iceberg label="Iceberg example" groups={[{ title: 'What you take home', parts: [{ label: 'Take-home pay', amount: 17000, value: '$17,000', color: 'var(--glow-2)' }] }, { title: 'What you pay', parts: [{ label: 'ISR', amount: 2400, value: '$2,400', color: 'var(--glow-1)' }, { label: 'IMSS (your share)', amount: 540, value: '$540', color: 'color-mix(in oklab, var(--glow-1) 55%, var(--card))' }] }, { title: 'What your employer pays', parts: [{ label: 'IMSS', amount: 1900, value: '$1,900', color: 'var(--glow-3)' }, { label: 'Retirement (SAR)', amount: 2000, value: '$2,000', color: 'color-mix(in oklab, var(--glow-3) 70%, var(--card))' }, { label: 'Infonavit', amount: 1050, value: '$1,050', color: 'color-mix(in oklab, var(--glow-3) 45%, var(--card))' }] }]} /></div><div class="result-panel mt-4 gap-3"><p class="meta">.result-value · .result-cents</p><p class="result-value">$954<span class="result-cents">.76</span></p><p class="meta mt-2">.receipt · .receipt-fold · .amount-field · .faq</p><dl class="receipt"><div class="receipt-row"><dt>Customer pays</dt><dd>$1,000.00</dd></div><div class="receipt-row"><dt><span aria-hidden="true">− </span>Processing fees</dt><dd>$39.00</dd></div><div class="receipt-row receipt-total"><dt><span aria-hidden="true">= </span>You keep</dt><dd>$954.76</dd></div></dl><details class="receipt-fold"><summary><ChevronRight aria-hidden="true" size={14} strokeWidth={1.5} />Formula</summary><div class="receipt-formula"><p>1,000.00 × 3.6% + 3.00 = 39.00</p></div></details></div><div class="mt-4 @container"><p class="meta mb-2">.insights</p><dl class="insights"><div><dt>Effective fee</dt><dd>4.52%</dd></div><div><dt>To receive $1,000.00, charge</dt><dd>$1,047.21</dd></div></dl></div></div><div><p class="text-sm text-muted-foreground mb-4">Principles</p><p class="text-sm leading-7">Semantic tokens. Shared components.<br />Quiet motion. Visible focus.</p></div></div><div class="mb-12 grid gap-6 md:grid-cols-2"><div><p class="text-sm text-muted-foreground mb-4">.dropzone</p><div class="dropzone"><span class="font-medium text-foreground">Drop images or choose files</span><span class="meta">JPEG, PNG, WebP</span></div></div><div><p class="text-sm text-muted-foreground mb-4">.crop-stage · .crop-box · .crop-handle</p><div class="crop-stage"><div class="h-40 w-72 bg-[var(--glow-2)]"></div><div class="crop-box" style="left: 20%; top: 15%; width: 50%; height: 70%"><span class="crop-handle" style="left: 0%; top: 0%"></span><span class="crop-handle" style="left: 100%; top: 0%"></span><span class="crop-handle" style="left: 0%; top: 100%"></span><span class="crop-handle" style="left: 100%; top: 100%"></span></div></div></div></div><ComponentGallery locale={localeFromPath(Astro.url.pathname)} client:load /></section></Layout>
