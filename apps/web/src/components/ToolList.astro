---
import { CreditCard, CarFront, House, PiggyBank, Image, Film, ArrowUpRight } from 'lucide-react';
import { tools, upcomingTools } from '@portfolio/site/lib/site';
const icons = { stripe: CreditCard, car: CarFront, home: House, savings: PiggyBank, image: Image, video: Film };
const categories = [...new Set([...tools, ...upcomingTools].map(tool => tool.category))];
---
<div class="flex flex-col gap-10">{categories.map(category => <section aria-label={category}>
  <p class="meta mb-3">{category}</p>
  {tools.filter(tool => tool.category === category).map(tool => { const Icon = icons[tool.icon]; return <a href={`/tools/${tool.slug}`} class="tool-row group"><span class="tool-icon"><Icon size={23} strokeWidth={1.5} /></span><div class="flex-1"><h3 class="text-lg font-medium tracking-tight">{tool.name}</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">{tool.description}</p></div><span class="meta hidden sm:block">{tool.tag}</span><ArrowUpRight size={20} strokeWidth={1.5} /></a>; })}
  {upcomingTools.filter(tool => tool.category === category).map(tool => { const Icon = icons[tool.icon]; return <div class="tool-row text-muted-foreground"><span class="tool-icon"><Icon size={23} strokeWidth={1.5} /></span><div class="flex-1"><h3 class="text-lg font-medium tracking-tight">{tool.name}</h3><p class="mt-1 text-sm leading-6">{tool.description}</p></div><span class="meta rounded-full border px-3 py-1">Coming soon</span></div>; })}
</section>)}</div>
