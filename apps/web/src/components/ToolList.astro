---
import { ArrowUpRight } from 'lucide-react';
import AppIcon from './AppIcon.astro';
import { tools, upcomingTools } from '@portfolio/site/lib/site';
import { localeFromPath, translate } from '@portfolio/i18n';
import { stripeFees, loanScenario, savingsGrowth, type Compounding, type FeeConfig } from '@portfolio/calculators';
import { stripeDefaults, loanDefaults, savingsDefaults } from '../stores/calculators';
import { money } from './calculators/Fields';
const locale = localeFromPath(Astro.url.pathname);
const whole = (value: number, currency: string) => new Intl.NumberFormat(locale === 'es' ? 'es-MX' : 'en-US', { style: 'currency', currency, maximumFractionDigits: 0 }).format(value);
const t = (text: string, values: Record<string, string | number>) => translate(text, locale, values);
// Each widget shows the result its tool opens with, computed from the same defaults so the two never disagree.
function example(icon: string) {
  if (icon === 'stripe') {
    const { currency, draft, amount } = stripeDefaults();
    const config = { ...Object.fromEntries(Object.entries(draft).map(([key, value]) => [key, Number(value)])), international: 0, conversion: 0 } as FeeConfig;
    return { caption: t('You receive from a {amount} charge', { amount: whole(Number(amount), currency) }), value: money(stripeFees(Number(amount), config).net, currency, locale) };
  }
  if (icon === 'car' || icon === 'home') {
    const { price, down, rate, months, currency } = loanDefaults(icon === 'home');
    const { payment } = loanScenario({ mode: 'payment', amount: Number(price), annualRate: Number(rate), months: Number(months), down: Number(down), downType: 'percent', tradeIn: 0 });
    const caption = icon === 'car' ? 'Per month · {price} car, {down}% down, {months} months' : 'Per month · {price} home, {down}% down, {years} years';
    return { caption: t(caption, { price: whole(Number(price), currency), down, months, years: Number(months) / 12 }), value: money(payment, currency, locale) };
  }
  const { initial, monthly, rate, years, compounding, currency } = savingsDefaults();
  const rows = savingsGrowth({ initial: Number(initial), monthly: Number(monthly), annualRate: Number(rate), years: Number(years), compounding: Number(compounding) as Compounding });
  return { caption: t('After {years} years · {initial} plus {monthly} a month at {rate}%', { years, initial: whole(Number(initial), currency), monthly: whole(Number(monthly), currency), rate }), value: money(rows.at(-1)!.balance, currency, locale) };
}
const categories = [...new Set([...tools, ...upcomingTools].map(tool => tool.category))];
---
<div class="flex flex-col gap-10">{categories.map(category => <section aria-label={category}>
  <p class="meta mb-4">{category}</p>
  <div class="grid gap-4 sm:grid-cols-2">
    {tools.filter(tool => tool.category === category).map(tool => { const { caption, value } = example(tool.icon); return <a href={`/tools/${tool.slug}`} class="tool-widget group">
      <div class="flex min-h-16 items-center gap-3">
        <AppIcon icon={tool.icon} />
        <div class="min-w-0"><h3 class="font-medium tracking-tight group-hover:underline group-hover:underline-offset-4">{tool.name}</h3><p class="meta">{tool.tag}</p></div>
        <ArrowUpRight aria-hidden="true" className="ml-auto shrink-0" size={18} strokeWidth={1.5} />
      </div>
      <p class="mt-6 min-h-10 text-xs leading-5 text-muted-foreground">{caption}</p>
      <p class="tool-widget-value">{value}</p>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">{tool.description}</p>
    </a>; })}
    {upcomingTools.filter(tool => tool.category === category).map(tool => <div class="tool-widget border-dashed text-muted-foreground">
      <div class="flex min-h-16 items-center gap-3"><AppIcon icon={tool.icon} /><div class="min-w-0"><h3 class="font-medium tracking-tight">{tool.name}</h3><p class="meta">{tool.category}</p></div><span class="meta ml-auto shrink-0 rounded-full border px-3 py-1">Coming soon</span></div>
      <p class="mt-6 text-sm leading-6">{tool.description}</p>
    </div>)}
  </div>
</section>)}</div>
