---
import { ArrowLeft, CircleHelp, X } from 'lucide-react';
import { buttonVariants } from '@portfolio/ui/components/button';
import Layout from '@portfolio/site/layouts/Layout.astro';
import { site, tools } from '@portfolio/site/lib/site';
import AppIcon from '../components/AppIcon.astro';
// `checked` names the date the tool's sources were last verified, shown next to the title.
// `app` opens the tool as a full-height workspace: a toolbar, the calculator's panes, and the guide in a side drawer.
interface Props { title: string; description: string; image: string; category: string; checked?: string; app?: boolean; }
const { title, description, image, category, checked, app = false } = Astro.props;
const tool = tools.find(item => Astro.url.pathname.includes(`/tools/${item.slug}`));
---
<Layout title={title} description={description} image={image} schema={{ '@context': 'https://schema.org', '@type': 'WebApplication', name: title, description, url: new URL(Astro.url.pathname, site.url).href, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, author: { '@type': 'Person', name: 'chermdev', url: site.github } }}>
  {app ? <>
    <div class="tool-app">
      <div class="tool-toolbar">
        {tool && <AppIcon icon={tool.icon} small />}
        <div class="min-w-0 flex-1"><h1 class="font-medium leading-snug tracking-tight sm:truncate">{title}</h1><nav aria-label="Breadcrumb" class="meta flex min-w-0 items-center gap-2"><a class="hover:text-foreground hover:underline underline-offset-4" href="/tools">Tools</a><span aria-hidden="true">/</span><span>{category}</span>{checked && <span class="hidden truncate sm:inline"><span aria-hidden="true">· </span>{checked}</span>}</nav></div>
        <nav aria-label="Switch tool" class="tool-switcher sm:ml-auto">{tools.map(item => <a href={`/tools/${item.slug}`} aria-label={item.name} title={item.name} aria-current={item.slug === tool?.slug ? 'page' : undefined}><AppIcon icon={item.icon} small /></a>)}</nav>
        <button type="button" class={buttonVariants({ variant: 'outline', size: 'sm', className: 'ml-auto shrink-0 sm:ml-0' })} data-open-guide aria-haspopup="dialog" aria-controls="tool-guide" aria-label="How it works"><CircleHelp aria-hidden="true" /><span class="hidden sm:inline">How it works</span></button>
      </div>
      <noscript><p class="m-5 rounded-lg border p-5">Enable JavaScript to use the interactive calculator. The formulas and assumptions are explained below.</p></noscript>
      <slot />
    </div>
    <dialog id="tool-guide" class="tool-guide" aria-labelledby="tool-guide-title">
      <div class="flex items-center justify-between gap-4 border-b pb-4"><p id="tool-guide-title" class="font-medium">How it works</p><form method="dialog"><button class={buttonVariants({ variant: 'ghost', size: 'icon' })} aria-label="Close"><X aria-hidden="true" /></button></form></div>
      <p class="mt-6 leading-7 text-muted-foreground">{description}</p>
      <div class="mt-8"><slot name="guide" /></div>
      <a class="text-link mt-10" href="/tools"><ArrowLeft aria-hidden="true" size={16} strokeWidth={1.5} /> Explore all tools</a>
    </dialog>
  </> : <>
    <section class="page-shell pt-10 pb-section">
      <nav aria-label="Breadcrumb" class="meta mb-6 flex items-center gap-2"><a class="hover:text-foreground hover:underline underline-offset-4" href="/tools">Tools</a><span aria-hidden="true">/</span><span>{category}</span></nav>
      <div class="mb-10 flex items-start gap-4">{tool && <AppIcon icon={tool.icon} />}<div><h1 class="subheading">{title}</h1><p class="mt-2 max-w-2xl leading-7 text-muted-foreground">{description}</p><p class="meta mt-3"><span>Runs in your browser</span>{checked && <><span aria-hidden="true"> · </span><span>{checked}</span></>}</p></div></div>
      <noscript><p class="rounded-lg border p-5 mb-8">Enable JavaScript to use the interactive calculator. The formulas and assumptions are explained below.</p></noscript>
      <slot />
      <section class="mt-16 border-t pt-12"><slot name="guide" /></section>
      <div class="mt-12 border-t pt-8"><a class="text-link" href="/tools"><ArrowLeft aria-hidden="true" size={16} strokeWidth={1.5} /> Explore all tools</a></div>
    </section>
  </>}
</Layout>
<script>
  // Open the guide drawer from the toolbar; a click on the backdrop closes it.
  const guide = document.getElementById('tool-guide') as HTMLDialogElement | null;
  document.querySelectorAll('[data-open-guide]').forEach(button => button.addEventListener('click', () => guide?.showModal()));
  guide?.addEventListener('click', event => { if (event.target === guide) guide.close(); });
</script>
