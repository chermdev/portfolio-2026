{
  "name": "chermdev-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.5 <11"
  },
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "node --experimental-strip-types --test packages/calculators/src/*.test.ts packages/i18n/src/*.test.ts",
    "preview": "pnpm --filter @portfolio/web preview",
    "og": "pnpm --filter @portfolio/web og",
    "verify:build": "node scripts/verify-build.mjs"
  }
}
